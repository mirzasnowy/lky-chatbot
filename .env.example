# Copy to .env and fill in. Never commit .env.
# Free key: https://openrouter.ai/keys (account + key are free; :free models cost $0).
OPENROUTER_API_KEY=
# Default model, verified free on 2026-11-06. The free list rotates: re-check
# https://openrouter.ai/models before a run; never guess a model id.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Vikey (paid fallback). Base URL exactly as given by Vikey, e.g.
# https://api.vikey.ai/v1 — the code appends "/chat/completions" itself.
VIKEY_API_KEY=
VIKEY_BASE_URL=
VIKEY_MODEL=openai/gpt-6-luna
VIKEY_MODEL_FALLBACK=deepseek/deepseek-v4-flash
# Max paid fallback calls per UTC day (300 x ~Rp 4 = ~Rp 1,200).
PAID_DAILY_CAP=300
# Comma-separated origins allowed to call the API (no wildcard).
ALLOWED_ORIGINS=http://localhost:8080
# Where the embedding model is cached (default <project>/.cache/fastembed).
MODEL_CACHE_DIR=
